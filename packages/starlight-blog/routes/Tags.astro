---
import type { InferGetStaticPropsType } from 'astro'

import Page from '../components/Page.astro'
import PostCount from '../components/PostCount.astro'
import Posts from '../components/Posts.astro'
import { getBlogConfig, getPageProps } from '../libs/page'
import { getTagsStaticPaths } from '../libs/tags'

export const prerender = true

export function getStaticPaths() {
  return getTagsStaticPaths()
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { prefix, entries, label, locale } = Astro.props

const config = getBlogConfig(prefix)
const pageProps = getPageProps(label)
---

<Page {...pageProps}>
  <PostCount
    >{
      Astro.locals.t('starlightBlog.tags.count', {
        interpolation: { escapeValue: false },
        count: entries.length,
        tag: label,
      })
    }</PostCount
  >
  <Posts {config} {entries} {locale} />
</Page>
