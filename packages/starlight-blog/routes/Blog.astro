---
import type { InferGetStaticPropsType } from 'astro'

import Page from '../components/Page.astro'
import Posts from '../components/Posts.astro'
import PrevNextLinks from '../components/PrevNextLinks.astro'
import { getBlogStaticPaths } from '../libs/content'
import { getBlogConfig, getPageProps } from '../libs/page'
import { getBlogTitle } from '../libs/title'

export const prerender = true

export function getStaticPaths() {
  return getBlogStaticPaths()
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { prefix, entries, locale, nextLink, prevLink } = Astro.props

const config = getBlogConfig(prefix)
const pageProps = getPageProps(getBlogTitle(config, locale))
---

<Page {...pageProps}>
  <Posts {config} {entries} {locale} />
  <footer class="not-content">
    <PrevNextLinks {config} next={nextLink} prev={prevLink} />
  </footer>
</Page>

<style>
  :global(.content-panel:first-of-type) {
    display: none;
  }

  :global(.content-panel:nth-of-type(2)) {
    border-top: none;
  }
</style>
