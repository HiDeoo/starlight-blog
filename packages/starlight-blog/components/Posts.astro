---
import type { StarlightBlogConfig } from '../libs/config'
import type { StarlightBlogEntry } from '../libs/content'
import type { Locale } from '../libs/i18n'

import Preview from './Preview.astro'

interface Props {
  config: StarlightBlogConfig
  entries: StarlightBlogEntry[]
  locale: Locale
}

const { config, entries, locale } = Astro.props
---

<div class="posts">
  {entries.map((entry) => <Preview {config} {entry} {locale} />)}
</div>

<style>
  .posts {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
</style>
