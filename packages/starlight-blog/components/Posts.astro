---
import type { StarlightBlogEntry } from '../libs/content'
import type { Locale } from '../libs/i18n'
import { getPathWithLocale, getRelativeUrl } from '../libs/page'

import Preview from './Preview.astro'

interface Props {
  entries: StarlightBlogEntry[]
  locale: Locale
  page: 'author' | 'posts' | 'tag'
}

const { entries, locale, page } = Astro.props
---

<div class="sl-blog-posts" data-blog-page={page}>
  {
    entries.map((entry) => (
      <Preview
        post={{
          entry,
          href: getRelativeUrl(`/${getPathWithLocale(entry.id, locale)}`),
        }}
      />
    ))
  }
</div>

<style>
  .sl-blog-posts {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
</style>
