---
import Default from '@astrojs/starlight/components/MarkdownContent.astro'

import { getBlogEntry } from '../../libs/content'
import { getBlogConfigFromPath, isAnyBlogPostPage } from '../../libs/page'
import Cover from '../Cover.astro'
import Metadata from '../Metadata.astro'
import PostTags from '../PostTags.astro'
import PrevNextLinks from '../PrevNextLinks.astro'

const { id, locale } = Astro.locals.starlightRoute
const config = getBlogConfigFromPath(id)

if (!config || !isAnyBlogPostPage(config, id)) {
  return null
}

const { entry, nextLink, prevLink } = await getBlogEntry(config, id, locale)
---

<Default>
  {entry.data.cover && <Cover cover={entry.data.cover} />}
  <Metadata {config} {entry} showBadges={false} />
  <slot />
  <div class="sl-blog-post-footer">
    <PostTags {config} entry={entry} {locale} />
    <PrevNextLinks {config} next={nextLink} prev={prevLink} />
  </div>
</Default>

<style>
  .sl-blog-post-footer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-block-start: 2rem !important;
  }
</style>
