---
import configs from 'virtual:starlight-blog/configs'

import { getRelativeBlogUrl } from '../../libs/page'
import { getBlogTitle } from '../../libs/title'

const { locale } = Astro.locals.starlightRoute
const headerStartConfigs = [...configs.values()].filter((blog) => blog.navigation === 'header-start')
---

{
  headerStartConfigs.length > 0 && (
    <div class="sl-blog-header-links">
      {headerStartConfigs.map((config) => (
        <a class="sl-blog-header-link" href={getRelativeBlogUrl(config, '/', locale)}>
          {getBlogTitle(config, locale)}
        </a>
      ))}
    </div>
  )
}

<style>
  .sl-blog-header-links {
    border-inline-start: 1px solid var(--sl-color-gray-5);
    display: none;
    gap: 1rem;
    margin-inline-start: 1rem;
    min-inline-size: 0;
    padding-inline-start: 1rem;
  }

  @media (min-width: 50rem) {
    .sl-blog-header-links {
      align-items: center;
      display: flex;
    }
  }

  .sl-blog-header-link {
    color: var(--sl-color-text-accent);
    font-weight: 600;
    min-inline-size: 0;
    overflow: hidden;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
