---
import configs from 'virtual:starlight-blog/configs'

import { getRelativeBlogUrl } from '../../libs/page'
import { getBlogTitle } from '../../libs/title'

const { locale } = Astro.locals.starlightRoute
const headerEndConfigs = [...configs.values()].filter((blog) => blog.navigation === 'header-end')
---

{
  headerEndConfigs.length > 0 && (
    <div>
      {headerEndConfigs.map((config) => (
        <a href={getRelativeBlogUrl(config, '/', locale)}>{getBlogTitle(config, locale)}</a>
      ))}
    </div>
  )
}

<style>
  div {
    border-inline-end: 1px solid var(--sl-color-gray-5);
    display: none;
    gap: 1rem;
    min-inline-size: 0;
    padding-inline-end: 1rem;
  }

  @media (min-width: 50rem) {
    :global(.header > .right-group) {
      min-inline-size: 0;
    }

    div {
      align-items: center;
      display: flex;
    }
  }

  a {
    color: var(--sl-color-text-accent);
    font-weight: 600;
    min-inline-size: 0;
    overflow: hidden;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
