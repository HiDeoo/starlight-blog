---
import type { StarlightBlogPostData } from '../data'
import { getBlogConfigFromPath, getLocaleFromRelativeUrl } from '../libs/page'

import Cover from './Cover.astro'
import Excerpt from './Excerpt.astro'
import Metadata from './Metadata.astro'
import PostTags from './PostTags.astro'

interface Props {
  post: Pick<StarlightBlogPostData, 'entry' | 'href'>
}

const { post } = Astro.props
const { entry } = post

const locale = getLocaleFromRelativeUrl(post.href)

const config = getBlogConfigFromPath(entry.id)
if (!config) throw new Error(`Failed to get blog configuration for entry '${entry.id}'.`)
---

<article class="preview">
  <header>
    <a class="preview-link" href={post.href}>
      <h2>{entry.data.title}</h2>
      {entry.data.cover && <Cover cover={entry.data.cover} alt="" />}
    </a>
    <Metadata {config} {entry} />
  </header>
  <div class="sl-markdown-content">
    <Excerpt {entry} />
  </div>
  <footer>
    <PostTags {config} {entry} {locale} />
  </footer>
</article>

<style>
  .preview {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .preview-link {
    display: inline-block;
    margin-bottom: 1.5rem;
    text-decoration: none;
  }

  .preview-link h2 {
    color: var(--sl-color-text-accent);
  }

  .preview-link:hover h2 {
    color: var(--sl-color-white);
  }

  .preview-link:has(figure) {
    display: block;
  }

  .preview-link:has(figure) h2 {
    margin-bottom: 1.5rem;
  }
</style>
