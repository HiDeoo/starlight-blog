---
import type { StarlightBlogPostData } from '../data'
import { getBlogConfigFromPath, getLocaleFromRelativeUrl } from '../libs/page'

import Cover from './Cover.astro'
import Excerpt from './Excerpt.astro'
import Metadata from './Metadata.astro'
import PostTags from './PostTags.astro'

interface Props {
  post: Pick<StarlightBlogPostData, 'entry' | 'href'>
}

const { post } = Astro.props
const { entry } = post

const locale = getLocaleFromRelativeUrl(post.href)

const config = getBlogConfigFromPath(entry.id)
if (!config) throw new Error(`Failed to get blog configuration for entry '${entry.id}'.`)
---

<article class="sl-blog-preview">
  <header class="sl-blog-preview-header">
    <a class="sl-blog-preview-link" href={post.href}>
      <h2 class="sl-blog-preview-title">{entry.data.title}</h2>
      {entry.data.cover && <Cover cover={entry.data.cover} alt="" />}
    </a>
    <Metadata {config} {entry} />
  </header>
  <div class="sl-blog-preview-excerpt sl-markdown-content">
    <Excerpt {entry} />
  </div>
  <footer class="sl-blog-preview-footer">
    <PostTags {config} {entry} {locale} />
  </footer>
</article>

<style>
  .sl-blog-preview {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sl-blog-preview-link {
    display: inline-block;
    margin-bottom: 1.5rem;
    text-decoration: none;
  }

  .sl-blog-preview-link .sl-blog-preview-title {
    color: var(--sl-color-text-accent);
  }

  .sl-blog-preview-link:hover .sl-blog-preview-title {
    color: var(--sl-color-white);
  }

  .sl-blog-preview-link:has(.sl-blog-cover) {
    display: block;
  }

  .sl-blog-preview-link:has(.sl-blog-cover) .sl-blog-preview-title {
    margin-bottom: 1.5rem;
  }
</style>
