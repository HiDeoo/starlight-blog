---
import type { StarlightBlogConfig } from '../libs/config'
import type { StarlightBlogEntry } from '../libs/content'
import type { Locale } from '../libs/i18n'
import { getRelativeBlogUrl } from '../libs/page'
import { getEntryTags } from '../libs/tags'

interface Props {
  config: StarlightBlogConfig
  entry: StarlightBlogEntry
  locale: Locale
}

const { config, entry, locale } = Astro.props

const tags = getEntryTags(entry)
---

{
  tags.length > 0 ? (
    <div class="sl-blog-tags">
      <b class="sl-blog-tags-label">{Astro.locals.t('starlightBlog.post.tags')}</b>
      <ul class="sl-blog-tags-list">
        {tags.map((tag) => (
          <li>
            <a class="sl-blog-tag" href={getRelativeBlogUrl(config, `/tags/${tag.slug}`, locale)}>
              {tag.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ) : null
}

<style>
  .sl-blog-tags-list {
    display: inline;
    margin-inline-start: 0.25rem;
    padding: 0;
  }

  li {
    display: inline-block;
    margin-bottom: 0.25rem;
    padding: 0;
  }

  .sl-blog-tag {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.3rem;
    font-size: var(--sl-text-sm);
    margin-inline: 0.2rem;
    padding: 0.25rem 0.5rem 0.35rem;
    text-decoration: none;
  }

  .sl-blog-tag:hover {
    border-color: var(--sl-color-gray-2);
  }
</style>
