---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import { authors } from 'virtual:starlight-blog/images'

import type { StarlightBlogConfig } from '../libs/config'
import { getRelativeUrl } from '../libs/page'
import type { StarlightBlogAuthor } from '../schema'

interface Props {
  author: StarlightBlogAuthor
  config: StarlightBlogConfig
}

const { author, config } = Astro.props

const isLink = author.url !== undefined
const Element = isLink ? 'a' : 'div'

const picture = authors[config.prefix]?.[author.name] ?? author.picture

const pictureSrc = (
  picture === undefined
    ? undefined
    : typeof picture === 'string'
      ? picture.startsWith('http')
        ? picture
        : getRelativeUrl(picture, true)
      : picture
) as ImageMetadata | undefined
---

<Element href={isLink ? author.url : undefined} class="sl-blog-author">
  {
    pictureSrc && (
      <Image class="sl-blog-author-picture" alt={author.name} loading="eager" src={pictureSrc} height={40} width={40} />
    )
  }
  <div class="sl-blog-author-details">
    <div class="sl-blog-author-name">{author.name}</div>
    {author.title && <div class="sl-blog-author-title">{author.title}</div>}
  </div>
</Element>

<style>
  .sl-blog-author {
    align-items: center;
    display: flex;
    gap: 0.5rem;
    line-height: var(--sl-line-height-headings);
    text-decoration: none;
  }

  .sl-blog-author-details {
    display: flex;
    flex-direction: column;
  }

  .sl-blog-author-name {
    font-size: var(--sl-text-base);
    font-weight: 600;
  }

  .sl-blog-author[href] .sl-blog-author-name {
    color: var(--sl-color-text-accent);
  }

  .sl-blog-author-title {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-text);
  }

  .sl-blog-author[href]:hover .sl-blog-author-name {
    color: var(--sl-color-text);
  }

  .sl-blog-author-picture {
    border: 1px solid var(--sl-color-gray-2);
    border-radius: 9999px;
    height: 2.5rem;
    width: 2.5rem;
  }
</style>
